{
  "expo": {
    "name": "HiddenReps",
    "slug": "hiddenreps",
    "scheme": "hiddenreps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hiddenlab.hiddenreps",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "youtube",
          "youtube"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "com.hiddenlab.hiddenreps"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": "운동하는 모습을 촬영하려면 카메라 접근 권한이 필요합니다.",
          "microphonePermission": "촬영한 영상에 소리를 담으려면 마이크 접근 권한이 필요합니다.",
          "photosPermission": "촬영한 영상을 갤러리에 저장하려면 사진 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "촬영한 영상을 갤러리에서 불러와 다시 재생하려면 사진 접근 권한이 필요합니다.",
          "savePhotosPermission": "촬영한 영상을 갤러리에 저장하려면 사진 접근 권한이 필요합니다.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-share-intent",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B0B0E",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6810020420008072~5306176842",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "맞춤 광고를 제공하기 위해 기기 식별자를 사용합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "26cd7654-0215-4e26-b32c-0f9aa0d89109"
      }
    },
    "owner": "hiddenlabs-team"
  }
}
